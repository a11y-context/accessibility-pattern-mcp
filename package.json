{
  "name": "@a11y-context/mcp-server",
  "version": "0.1.5",
  "description": "Model Context Protocol server that serves the A11y Context accessibility-pattern corpus (WCAG 2.2 AA patterns, Foundations rules) to AI coding agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "a11y-context-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "corpus/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http.js",
    "dev:http": "tsx watch src/http.ts",
    "inspector": "npm run build && mcp-inspector node dist/index.js",
    "smoke:remote": "npm run build && node dist/smoke/smoke-remote-mcp.js",
    "smoke:stdio": "npm run build && node scripts/smoke-stdio.mjs",
    "test:regression": "npm run build && node scripts/regression-runner.mjs",
    "test:regression:update": "npm run build && node scripts/regression-runner.mjs --update",
    "test:regression:ignore-ttl": "npm run build && node scripts/regression-runner.mjs --ignore-cache-ttl",
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "accessibility",
    "a11y",
    "wcag",
    "react",
    "ai-agents",
    "patterns"
  ],
  "author": "John Sweet",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11y-context/accessibility-pattern-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/a11y-context/accessibility-pattern-mcp/issues"
  },
  "homepage": "https://a11y-context-project.vercel.app/getting-started/ai-coding-agents/install/mcp-server",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
